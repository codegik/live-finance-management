DATABASE_URL=postgres://user:password@localhost:5432/finance

# Generate each of these separately. They are validated at startup and a value
# left as CHANGE_ME is rejected outright — these placeholders are public in
# this repository, so treating one as a secret would mean having none.
#
#   openssl rand -base64 32
#
# For PLUGGY_WEBHOOK_TOKEN, prefer a URL-safe value, because it is carried in
# a query string and `+` and `/` need escaping there:
#
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#
AUTH_SECRET=CHANGE_ME
PLUGGY_WEBHOOK_TOKEN=CHANGE_ME
CRON_SECRET=CHANGE_ME

# From your application at https://dashboard.pluggy.ai — see PLUGGY_SETUP.md
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_API_URL=https://api.pluggy.ai
