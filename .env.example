DATABASE_URL=postgres://user:password@localhost:5432/finance

# Generate each of these separately. They are validated at startup and a value
# left as CHANGE_ME is rejected outright — these placeholders are public in
# this repository, so treating one as a secret would mean having none.
#
#   openssl rand -base64 32
#
# For PLUGGY_WEBHOOK_TOKEN, prefer a URL-safe value, because it is carried in
# a query string and `+` and `/` need escaping there:
#
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#
AUTH_SECRET=CHANGE_ME
PLUGGY_WEBHOOK_TOKEN=CHANGE_ME
CRON_SECRET=CHANGE_ME

# From your application at https://dashboard.pluggy.ai — see PLUGGY_SETUP.md
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_API_URL=https://api.pluggy.ai

# Budget alerts. From https://resend.com — the sending domain must be verified,
# or the mail lands in spam, which from the household's side is indistinguishable
# from no alert at all.
RESEND_API_KEY=replace-with-your-resend-api-key
ALERT_EMAIL_FROM=alerts@yourdomain.com

# LOCAL DEVELOPMENT ONLY. Signs in automatically as the account ./seed.sh
# creates, so `./start.sh` opens on a populated app instead of a login form.
#
# Left unset here on purpose. It is ignored in a production build and ignored
# unless DATABASE_URL points at localhost, but a switch that turns off
# authentication has no business being on by default in a committed file.
# ./start.sh writes it into .env.local, which is not committed.
# LOCAL_AUTOLOGIN=true
