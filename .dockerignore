# Keep the build context small and free of host-specific state.
node_modules
.next
.git
.github

# Local runtime artefacts from ./start.sh
.env
.env.*
!.env.example
.dev-server.log
.dev-server.pid

# Tests and tooling never run in the image.
tests
docs
.claude
.superpowers
*.md
!README.md

# Local scripts. seed.sh/seed.ts create the fixed-password owner@localhost
# account and demo.ts writes invented salaries — none of it has any business
# being reachable from a production image, even though each also refuses to
# run against a non-local database. Two locks, because the cost is one line.
start.sh
stop.sh
test.sh
seed.sh
seed.ts
demo.ts
tools
