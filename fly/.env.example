# Template for fly/.env.production and fly/.env.staging (both gitignored).
# Copy this file, fill in REAL values, and push with:  bash fly/set-secrets.sh [env]
# These are consumed by `fly secrets import`, so keep the plain KEY=VALUE format
# (no `export`, no quotes needed unless a value contains spaces).

# --- Auth session signing key ---
# Generate ONCE, then keep it stable (changing it logs everyone out):
#   openssl rand -base64 32
AUTH_SECRET=

# --- Pluggy (from https://dashboard.pluggy.ai — see PLUGGY_SETUP.md) ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_API_URL=https://api.pluggy.ai
# Rides in the webhook query string, so it must be URL-safe. Generate ONCE:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
PLUGGY_WEBHOOK_TOKEN=

# --- Manual cron trigger secret (Bearer for /api/cron/reconcile) ---
# Generate ONCE and keep stable:  openssl rand -base64 32
CRON_SECRET=

# --- Budget alert email (Resend — the sending domain must be verified) ---
RESEND_API_KEY=
ALERT_EMAIL_FROM=onboarding@resend.dev
